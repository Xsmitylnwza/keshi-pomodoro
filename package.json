{
  "name": "pomodoro-keshi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/pomodoro-server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "desktop:dev": "npm --prefix desktop run dev",
    "seed:local": "node scripts/seed-local.mjs",
    "seed:local:force": "node scripts/seed-local.mjs --force",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:process-kill": "node --test tests/timer-process-kill.integration.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/crimson-text": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "license": "MIT",
  "description": "Lo-fi Pomodoro timer with daily sprint tasks, Calendar cues, and privacy-safe focus analytics",
  "author": "Xsmity",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xsmitylnwza/keshi-pomodoro.git"
  },
  "bugs": {
    "url": "https://github.com/Xsmitylnwza/keshi-pomodoro/issues"
  },
  "homepage": "https://pomodoro.xsmity.cloud/",
  "keywords": [
    "pomodoro",
    "focus",
    "timer",
    "tasks",
    "calendar",
    "react",
    "vite",
    "lofi"
  ]
}
